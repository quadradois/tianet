# Server-only. Nunca use NEXT_PUBLIC_ para estes valores.
FRONTEND_BACKEND_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://127.0.0.1:3000

# Gere 32 bytes aleatorios e codifique em base64url. Nao reutilize este placeholder.
FRONTEND_SESSION_KEY_ID=local-v1
FRONTEND_SESSION_KEY=REPLACE_WITH_32_RANDOM_BYTES_BASE64URL

# O par anterior e opcional e existe apenas durante rotacao de chave.
# FRONTEND_SESSION_PREVIOUS_KEY_ID=local-v0
# FRONTEND_SESSION_PREVIOUS_KEY=REPLACE_WITH_PREVIOUS_32_BYTES_BASE64URL
