#!/bin/sh
# pre-commit — valida documentação e frontend (lint + typecheck) antes de cada commit.
# Em caso de erro, o commit é cancelado e o relatório é exibido.

echo "pre-commit: validando documentação..."
npm run docs:validate || exit 1

echo "pre-commit: lint do frontend..."
cd frontend && npm run lint || exit 1

echo "pre-commit: typecheck do frontend..."
npm run typecheck || exit 1

echo "pre-commit: OK"
