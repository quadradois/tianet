# Copie este arquivo para `.env` e preencha o que estiver vazio:
#
#     cp .env.example .env
#
# Depois disso, `docker compose up` deve subir a stack inteira. Nenhum valor
# real de segredo pertence a este arquivo — ele e versionado.

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# POSTGRES_PASSWORD e obrigatoria: o Compose recusa subir sem ela. Escolha
# qualquer segredo local; em producao, use um gerenciador de segredos.
POSTGRES_PASSWORD=

# Usada apenas fora do Compose (pytest, alembic, uvicorn na maquina). Dentro dos
# containers o Compose monta a sua propria DATABASE_URL apontando para o host
# `postgres`. Prefira 127.0.0.1 a localhost: localhost tenta ::1 primeiro e
# espera o timeout inteiro antes de cair para IPv4, o que faz a suite parecer
# travada em vez de falhar.
DATABASE_URL=postgresql+psycopg://emprestimo:TROQUE_PELA_SENHA_ACIMA@127.0.0.1:5432/emprestimo

# ---------------------------------------------------------------------------
# Aplicacao
# ---------------------------------------------------------------------------
# development | production. Em production o worker recusa iniciar sem as
# variaveis do Resend.
APP_ENV=development

JWT_SECRET_KEY=

# Bootstrap operacional temporario do primeiro Administrador da Plataforma.
# Gere o SHA-256 de um segredo aleatorio com no minimo 32 caracteres.
PLATFORM_ADMIN_BOOTSTRAP_ENABLED=false
PLATFORM_ADMIN_BOOTSTRAP_SECRET_HASH=

# ---------------------------------------------------------------------------
# Portas publicadas no host
# ---------------------------------------------------------------------------
# Sao propriedade da maquina, nao do projeto: mude aqui se ja houver outro
# Postgres, outra API ou outro Next.js rodando. Deixar em branco mantem os
# padroes 5432, 8000 e 3000.
POSTGRES_PORT=5432
API_PORT=8000
FRONTEND_PORT=3000

# FRONTEND_ORIGIN precisa acompanhar FRONTEND_PORT, porque o BFF recusa
# requisicao de origem diferente da configurada.
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_LOGIN_TENANT_IDENTIFICADOR=tianet-local

# ---------------------------------------------------------------------------
# Sessao do frontend (obrigatorias — o Compose recusa subir sem elas)
# ---------------------------------------------------------------------------
# FRONTEND_SESSION_KEY: 32 bytes aleatorios em base64url, exatamente 43
# caracteres, sem padding. Gere com:
#
#     python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip('='))"
#
# FRONTEND_SESSION_KEY_ID: rotulo livre que identifica a chave em uso, para
# permitir rotacao. Qualquer string curta serve (ex.: `local-1`).
FRONTEND_SESSION_KEY_ID=local-1
FRONTEND_SESSION_KEY=

# ---------------------------------------------------------------------------
# Notificacoes (opcionais em development)
# ---------------------------------------------------------------------------
# Sem RESEND_*, e com APP_ENV != production, o worker usa FakeNotificationChannel
# e nao envia nada de verdade. Em production as duas passam a ser obrigatorias.
RESEND_API_KEY=
RESEND_FROM=

# Host nao secreto do Evolution Go, o provedor de WhatsApp. Ver
# docs/whatsapp/CRM_EVOLUTION_CONTRACT.md e docs/operations/contexto-externo.md.
EVOLUTION_HOST=https://diamondgreen.com.br

# Token de UMA instancia do Evolution, usado sozinho no envio (sem X-Tenant-ID).
# Vazio desliga o envio real de WhatsApp. O armazenamento de tokens por Tenant
# ainda e pergunta em aberto (contexto-externo §6, pergunta 2) — por isso esta
# variavel serve para um unico emissor, nao para multiplos Credores.
EVOLUTION_INSTANCE_TOKEN=
