FROM ghcr.io/astral-sh/uv@sha256:a5727064a0de127bdb7c9d3c1383f3a9ac307d9f2d8a391edc7896c54289ced0 AS uv-dist

FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea

COPY --from=uv-dist /uv /usr/local/bin/uv

ARG CODEX_VERSION=0.146.1
ARG CODEX_SHA256=f558105aec12bf6fb33570793adfc089f8b41dc32aced60b8b4fba9b451824ac

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CODEX_HOME=/var/lib/tianet-agent/codex \
    TIANET_AGENT_RUNTIME=/tmp/tianet-agent \
    TIANET_AGENT_SOCKET=/run/tianet-agent/agent.sock

WORKDIR /app

RUN CODEX_VERSION="${CODEX_VERSION}" CODEX_SHA256="${CODEX_SHA256}" python - <<'PY'
import hashlib
import io
import os
import pathlib
import tarfile
import urllib.request

version = os.environ["CODEX_VERSION"]
expected = os.environ["CODEX_SHA256"]
url = (
    "https://github.com/openai/codex/releases/download/"
    f"rust-v{version}/codex-x86_64-unknown-linux-musl.tar.gz"
)
archive = urllib.request.urlopen(url, timeout=60).read()
if hashlib.sha256(archive).hexdigest() != expected:
    raise SystemExit("checksum do Codex CLI divergiu")
with tarfile.open(fileobj=io.BytesIO(archive), mode="r:gz") as package:
    member = package.getmember("codex-x86_64-unknown-linux-musl")
    source = package.extractfile(member)
    if source is None:
        raise SystemExit("binario Codex ausente do pacote")
    destination = pathlib.Path("/usr/local/bin/codex")
    destination.write_bytes(source.read())
    destination.chmod(0o755)
PY
RUN test "$(codex --version)" = "codex-cli ${CODEX_VERSION}"

COPY src/emprestimo/agent/codex_app_server_protocol.v2.sha256 /tmp/schema.sha256
RUN python - <<'PY'
import hashlib
import json
import os
import pathlib
import shutil
import subprocess

schema_root = pathlib.Path("/tmp/codex-schema")
codex_home = pathlib.Path("/tmp/codex-schema-home")
schema_root.mkdir()
codex_home.mkdir()
environment = os.environ.copy()
environment["CODEX_HOME"] = str(codex_home)
subprocess.run(
    ["codex", "app-server", "generate-json-schema", "--out", str(schema_root)],
    check=True,
    env=environment,
)
schema = json.loads(
    (schema_root / "codex_app_server_protocol.v2.schemas.json").read_text()
)
canonical = json.dumps(schema, sort_keys=True, separators=(",", ":")).encode()
actual = hashlib.sha256(canonical).hexdigest()
expected = pathlib.Path("/tmp/schema.sha256").read_text().strip()
if actual != expected:
    raise SystemExit("schema do Codex App Server divergiu")
shutil.rmtree(schema_root)
shutil.rmtree(codex_home)
pathlib.Path("/tmp/schema.sha256").unlink()
PY

COPY requirements-agent.lock ./requirements-agent.lock
RUN uv pip install --system --no-cache --require-hashes \
        --index-url https://pypi.tuna.tsinghua.edu.cn/simple \
        -r requirements-agent.lock \
    && python -m pip check
COPY src/emprestimo/__init__.py ./emprestimo/__init__.py
COPY src/emprestimo/agent ./emprestimo/agent

RUN groupadd --gid 10003 agentipc \
    && useradd --create-home --uid 10002 --gid agentipc agent \
    && mkdir --parents /var/lib/tianet-agent/codex /tmp/tianet-agent /run/tianet-agent \
    && chown --recursive agent:agentipc /var/lib/tianet-agent /tmp/tianet-agent /run/tianet-agent \
    && chmod 0750 /run/tianet-agent

USER agent

HEALTHCHECK --interval=5s --timeout=3s --retries=12 \
  CMD python -m emprestimo.agent.server health

CMD ["python", "-m", "emprestimo.agent.server", "serve"]
